<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/imgTemperature"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="#333333"
            android:contentDescription="@string/image_description"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/instructions"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtTemperature"
            android:layout_width="320dp"
            android:layout_height="56dp"
            android:hint="@string/temperature_hint"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:textColor="#222222"
            android:textColorHint="#666666"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnFahrenheitToCelsius"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_f_to_c"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCelsiusToFahrenheit"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_c_to_f"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/result_placeholder"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center" />

    </LinearLayout>

</ScrollView>
